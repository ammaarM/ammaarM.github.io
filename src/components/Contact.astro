---
import { Mail, Code, Briefcase, FileText, Copy } from 'lucide-react';
import Pane from './Pane.astro';
import { profile } from '../data/profile';

const email = profile.links.email.replace(/^mailto:/, '');
const links = [
  { href: profile.links.linkedin, label: 'LinkedIn', icon: Briefcase },
  { href: profile.links.github, label: 'GitHub', icon: Code },
  { href: profile.cvUrl, label: 'CV (PDF)', icon: FileText },
];
---
<section class="tmux-window window--contact" id="contact" data-section="contact" aria-labelledby="contact-title" tabindex="-1">
  <Pane title="ping ammaar" index="4" class="pane--contact">
    <div class="contact-body">
      <div class="contact-copy">
        <h2 id="contact-title">Got a platform that needs a hand?</h2>
        <p>Cloud and DevOps roles, Azure or Terraform questions, or just to say hi. Email gets the fastest reply.</p>
      </div>
      <ul class="contact-links">
        <li class="contact-email">
          <a class="btn contact-link" href={profile.links.email}>
            <Mail className="contact-icon" aria-hidden="true" size={18} strokeWidth={1.75} />
            Email
          </a>
          <button class="btn ghost contact-copy-btn" type="button" data-copy={email} data-js-only hidden>
            <Copy className="contact-icon" aria-hidden="true" size={16} strokeWidth={1.75} />
            <span data-copy-label>Copy address</span>
          </button>
        </li>
        {
          links.map(({ href, label, icon: Icon }) => (
            <li>
              <a class="btn ghost contact-link" href={href} target="_blank" rel="noreferrer">
                <Icon className="contact-icon" aria-hidden="true" size={18} strokeWidth={1.75} />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Pane>
</section>
