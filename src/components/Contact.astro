---
import { Mail, Code, Briefcase, FileText } from 'lucide-react';
import { profile } from '../data/profile';

const links = [
  { href: profile.links.email, label: 'Email', icon: Mail, external: false },
  { href: profile.links.linkedin, label: 'LinkedIn', icon: Briefcase, external: true },
  { href: profile.links.github, label: 'GitHub', icon: Code, external: true },
  { href: profile.cvUrl, label: 'CV (PDF)', icon: FileText, external: true },
];
---
<section class="contact" id="contact" aria-labelledby="contact-title" data-section="contact" data-reveal tabindex="-1">
  <div class="section-shell" data-reveal-group>
    <div class="contact-card terminal" data-reveal-item>
      <div class="terminal-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p class="terminal-title">ping ammaar</p>
      </div>
      <div class="contact-body">
        <p class="eyebrow">04 · contact</p>
        <h2 id="contact-title">Got a platform that needs a hand?</h2>
        <p>Cloud and DevOps roles, Azure or Terraform questions, or just to say hi. Email gets the fastest reply.</p>
        <ul class="contact-links">
          {
            links.map(({ href, label, icon: Icon, external }) => (
              <li>
                <a
                  class="btn ghost contact-link"
                  href={href}
                  {...(external ? { target: '_blank', rel: 'noreferrer' } : {})}
                >
                  <Icon className="contact-icon" aria-hidden="true" size={18} strokeWidth={1.75} />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
