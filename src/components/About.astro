---
import { experience, profile } from "../data/profile";
---

<section class="about" id="about" aria-labelledby="about-title" data-section="about" data-reveal tabindex="-1">
  <div class="section-shell about-grid" data-reveal-group>
    <div class="section-header" data-reveal-item>
      <p class="eyebrow">01 · about</p>
      <h2 id="about-title">Infra by day, apps by night.</h2>
      <div class="about-media">
        <span class="avatar avatar--about" data-avatar data-initials="AM">
          <img
            src={profile.headshot.url}
            alt={profile.headshot.alt}
            width={profile.headshot.width}
            height={profile.headshot.height}
            loading="lazy"
            decoding="async"
            data-fallback={profile.fallback.src}
          />
          <span class="avatar-fallback" aria-hidden="true">AM</span>
        </span>
      </div>
      <p>
        I'm a DevOps Platform Engineer at CGI in London, specialising in Azure, Terraform and CI/CD governance. I'm the
        technical authority for the infrastructure code on a mission-critical billing platform, and I push for agentic AI
        tooling that speeds delivery up without loosening the guardrails.
      </p>
      <p>
        I like the whole path from <code>terraform plan</code> to a product someone actually uses. That's why I co-founded
        Sabr Labs, and why I run a home lab of self-hosted services to try new tools on.
      </p>
    </div>

    <ol class="gitlog" aria-label="Experience" data-reveal-item>
      {
        experience.map((item, index) => (
          <li class="gitlog-entry">
            <span class="gitlog-node" aria-hidden="true" />
            <p class="gitlog-meta">
              {index === 0 && <span class="gitlog-ref">HEAD → main</span>}
              <span class="gitlog-date">{item.date}</span>
            </p>
            <h3 class="gitlog-title">
              {item.title} <span class="gitlog-org">@ {item.org}</span>
            </h3>
            {item.summary && <p class="gitlog-summary">{item.summary}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>
