---
const commit = (process.env.GITHUB_SHA ?? 'local').slice(0, 7);
const builtAt = new Date().toISOString().slice(0, 10);
---
<footer class="site-footer" data-reveal>
  <div class="container footer-inner">
    <small>© <span data-year></span> Ammaar Murshid</small>
    <small class="footer-build">
      built with Astro · deployed by GitHub Actions · <span title="Build commit">{commit}</span> · {builtAt}
    </small>
  </div>
</footer>
