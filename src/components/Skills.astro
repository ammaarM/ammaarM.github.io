---
import { Image } from 'astro:assets';
import azureIcon from '../assets/icons/azure.svg';
import terraformIcon from '../assets/icons/HashiCorp-Terraform.svg';
import powershellIcon from '../assets/icons/powershell.svg';
import bashIcon from '../assets/icons/Bash.svg';
import pythonIcon from '../assets/icons/python.svg';
import githubActionsIcon from '../assets/icons/github-actions.svg';
import dockerIcon from '../assets/icons/docker.svg';
import kubernetesIcon from '../assets/icons/kubernetes.svg';
import windowsIcon from '../assets/icons/Windows-11.svg';
import sqlIcon from '../assets/icons/Azure-SQL-Database.svg';
import javaIcon from '../assets/icons/java.svg';
import goIcon from '../assets/icons/Go.svg';
import typescriptIcon from '../assets/icons/TypeScript.svg';
import reactIcon from '../assets/icons/React.svg';
import linuxIcon from '../assets/icons/Linux.svg';
import awsIcon from '../assets/icons/AWS.svg';

const groups = [
  {
    name: 'cloud & iac',
    blurb: 'Where most of my day goes.',
    skills: [
      { label: 'Microsoft Azure', icon: azureIcon },
      { label: 'AWS', icon: awsIcon },
      { label: 'Terraform', icon: terraformIcon },
      { label: 'Kubernetes (CKA)', icon: kubernetesIcon },
      { label: 'Docker & Compose', icon: dockerIcon },
    ],
  },
  {
    name: 'pipelines & automation',
    blurb: 'If I do it twice, it becomes a script.',
    skills: [
      { label: 'GitHub Actions', icon: githubActionsIcon },
      { label: 'PowerShell', icon: powershellIcon },
      { label: 'Python', icon: pythonIcon },
      { label: 'Bash', icon: bashIcon },
    ],
  },
  {
    name: 'platform',
    blurb: 'The estate underneath.',
    skills: [
      { label: 'Windows Server & AD', icon: windowsIcon },
      { label: 'Linux', icon: linuxIcon },
      { label: 'SQL', icon: sqlIcon },
    ],
  },
  {
    name: 'building',
    blurb: 'What the side projects run on.',
    skills: [
      { label: 'TypeScript', icon: typescriptIcon },
      { label: 'React', icon: reactIcon },
      { label: 'Go', icon: goIcon },
      { label: 'Java', icon: javaIcon },
    ],
  },
];
---

<section class="skills" id="skills" aria-labelledby="skills-title" data-section="skills" data-reveal tabindex="-1">
  <div class="section-shell" data-reveal-group>
    <div class="section-header" data-reveal-item>
      <p class="eyebrow">02 · stack</p>
      <h2 id="skills-title">Tools I reach for</h2>
    </div>
    <div class="skill-groups">
      {
        groups.map((group, index) => (
          <div class="skill-group" style={{ '--stagger-index': index }} data-reveal-item>
            <h3 class="skill-group-name">
              <span aria-hidden="true">./</span>
              {group.name}
            </h3>
            <p class="skill-group-blurb">{group.blurb}</p>
            <ul class="skill-list">
              {group.skills.map((skill) => (
                <li class="skill-chip">
                  <span class="skill-chip-icon">
                    <Image src={skill.icon} alt="" width={22} height={22} loading="lazy" />
                  </span>
                  {skill.label}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
