---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectsTable from '../components/ProjectsTable.astro';
import Contact from '../components/Contact.astro';

const pageTitle = 'Ammaar Murshid · DevOps Platform Engineer';
const description =
  'Ammaar Murshid is a DevOps Platform Engineer at CGI in London, working with Azure, Terraform, Kubernetes and CI/CD, and co-founder of Sabr Labs.';
---
<BaseLayout title={pageTitle} description={description}>
  <Hero />
  <About />
  <ProjectsTable />
  <Contact />
</BaseLayout>
